{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "ProtonLauncher",
  "version": "1.6.0",
  "default_locale": "en",
  "description": "__MSG_extDescription__",
  "author": "Esli Silva",
  "homepage_url": "https://github.com/Esl1h/proton-launcher-extension",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "__MSG_commandOpen__"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "minimum_chrome_version": "100",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:; connect-src 'self' https://status.proton.me;"
  }
}
